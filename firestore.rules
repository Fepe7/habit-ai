rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Denegar todo por defecto
    match /{document=**} {
      allow read, write: if false;
    }

    // Funciones helper
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Documentos privados del usuario.
    // Los campos premium (isPremium, premiumUntil) y la cuota free del chat
    // (freePlanUsage) los escribe SOLO el Admin SDK: un cliente no puede
    // autoconcederse premium ni resetear su cuota.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && !request.resource.data.keys()
                       .hasAny(['isPremium', 'premiumUntil', 'freePlanUsage']);
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['isPremium', 'premiumUntil', 'freePlanUsage']);
      allow delete: if isOwner(userId);

      match /habits/{habitId} {
        allow read, write: if isOwner(userId);

        match /logs/{logId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /achievements/{achievementId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        // inmutables una vez desbloqueados: no se pueden modificar...
        allow update: if false;
        // ...pero el dueño sí puede borrarlos (eliminación de cuenta / GDPR)
        allow delete: if isOwner(userId);
      }

      match /ai_conversations/{conversationId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if false;
        // el dueño puede borrar su historial (eliminación de cuenta / GDPR)
        allow delete: if isOwner(userId);
      }

      match /weekly_reviews/{weekId} {
        allow read:   if isOwner(userId);
        // solo crea/actualiza el admin SDK (Cloud Function);
        // el dueño puede borrar (eliminación de cuenta / GDPR)
        allow create, update: if false;
        allow delete: if isOwner(userId);
      }

      match /butterfly_projections/{monthId} {
        allow read:   if isOwner(userId);
        allow create, update: if false;
        allow delete: if isOwner(userId);
      }

      match /pattern_insights/{periodId} {
        allow read:   if isOwner(userId);
        // escritura solo desde el admin SDK (Cloud Function);
        // el dueño puede borrar (eliminación de cuenta / GDPR)
        allow create, update: if false;
        allow delete: if isOwner(userId);
      }

      match /renegotiations/{habitId} {
        allow read:   if isOwner(userId);
        // el cliente solo puede marcar el ciclo de vida (applied/dismissed)
        allow update: if isOwner(userId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['appliedAt', 'dismissedAt']);
        // la escritura inicial solo desde el admin SDK (Cloud Function);
        // el dueño puede borrar (eliminación de cuenta / GDPR)
        allow create: if false;
        allow delete: if isOwner(userId);
      }

      match /shield_grants/{grantId} {
        allow read, write: if isOwner(userId);
      }

      match /habit_groups/{groupId} {
        allow read, write: if isOwner(userId);
      }

      // Registros de estado de ánimo — solo el propietario, nunca públicos
      match /mood_entries/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Tokens de FCM del dispositivo — solo el propietario los escribe;
      // las Cloud Functions los leen vía admin SDK (se saltan las reglas).
      match /fcm_tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Perfiles públicos — lectura abierta, escritura solo del propio usuario
    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /habits/{habitId} {
        // Los hábitos 'public' los lee cualquiera; los 'followers' SOLO el
        // dueño o un seguidor confirmado. Sin esto, un hábito marcado "solo
        // seguidores" quedaría expuesto a cualquiera que consultara el espejo
        // directamente (el filtro de cliente no es una barrera de seguridad).
        allow read: if resource.data.visibility == 'public'
                    || (request.auth != null
                        && (request.auth.uid == userId
                            || exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))));
        allow create, update: if request.auth != null && request.auth.uid == userId
                              && request.resource.data.visibility in ['public', 'followers'];
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /challenges/{challengeId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Reacciones al perfil — doc ID = reactorUid (una reacción por persona)
      match /reactions/{reactorUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && reactorUid == request.auth.uid
                      && request.resource.data.reactorUid == request.auth.uid
                      && request.resource.data.emoji in ['🔥', '💪', '👏']
                      && request.resource.data.keys().hasAll([
                           'reactorUid', 'reactorUsername', 'reactorDisplayName',
                           'emoji', 'createdAt']);
        allow update: if request.auth != null
                      && reactorUid == request.auth.uid
                      && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['emoji', 'createdAt']);
        // Borra el propio reactor, o el DUEÑO del perfil (necesario para limpiar
        // sus reacciones al eliminar la cuenta — si no, quedarían huérfanas).
        allow delete: if request.auth != null
                      && (reactorUid == request.auth.uid
                          || userId == request.auth.uid);
      }
    }

    // Marketplace de plantillas de la comunidad
    match /community_templates/{templateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && exists(/databases/$(database)/documents/public_profiles/$(request.auth.uid));
      allow update: if request.auth != null
                    && (resource.data.authorUid == request.auth.uid
                        || request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['importCount','reportCount','updatedAt']));
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;

      match /habits/{habitId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/community_templates/$(templateId))
                        .data.authorUid == request.auth.uid;
      }
    }

    // Retos compartidos entre dos usuarios
    match /challenges/{challengeId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participantUids;
      allow create: if request.auth != null
                    && request.resource.data.creatorUid == request.auth.uid
                    && request.auth.uid in request.resource.data.participantUids;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participantUids
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'startDate', 'endDate', 'completedAt']);
      allow delete: if false;

      match /participants/{participantUid} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/challenges/$(challengeId)).data.participantUids;
        allow create, update: if request.auth != null
                              && request.auth.uid == participantUid;
        allow delete: if false;
      }

      match /progress/{progressUid} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/challenges/$(challengeId)).data.participantUids;
        allow create, update: if request.auth != null
                              && request.auth.uid == progressUid;
        allow delete: if false;
      }
    }

    // Reserva de usernames — lectura abierta para isUsernameAvailable
    match /usernames/{username} {
      allow read: if true;
      // Solo puede crear si el doc apunta al uid del caller
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      // Solo puede borrar el dueño del username
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      // Inmutable: cambiar username = delete + create
      allow update: if false;
    }

    // Directorio ligero de usuarios — cualquier autenticado puede leer para buscar
    match /user_directory/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Solicitudes de seguimiento — solo los dos involucrados pueden leer
    match /follow_requests/{requestId} {
      allow read: if request.auth != null
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
      // Solo el receptor puede actualizar el estado (aceptar/rechazar);
      // expiresAt es el campo TTL que acorta la retención al resolver
      allow update: if request.auth != null
                    && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['status', 'respondedAt', 'expiresAt']);
      // El remitente puede cancelar su solicitud mientras siga pendiente
      allow delete: if request.auth != null
                    && resource.data.fromUid == request.auth.uid
                    && resource.data.status == 'pending';
    }

    // Seguidores — el follower crea su propio doc O el owner crea al aceptar una solicitud
    match /users/{userId}/followers/{followerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && (request.auth.uid == followerId || isOwner(userId));
      allow delete: if isOwner(userId) || request.auth.uid == followerId;
      allow update: if false;
    }

    // Siguiendo — el owner escribe; el seguido puede crear si aporta prueba de solicitud válida
    match /users/{userId}/following/{followingId} {
      allow read: if request.auth != null;
      allow create: if isOwner(userId)
                    || (request.auth != null
                        && request.auth.uid == followingId
                        && request.resource.data.keys().hasAll(['acceptedRequestId'])
                        && get(/databases/$(database)/documents/follow_requests/$(request.resource.data.acceptedRequestId)).data.toUid == request.auth.uid
                        && get(/databases/$(database)/documents/follow_requests/$(request.resource.data.acceptedRequestId)).data.fromUid == userId
                        && get(/databases/$(database)/documents/follow_requests/$(request.resource.data.acceptedRequestId)).data.status == 'pending');
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // Flag de disponibilidad de IA — cualquier usuario autenticado puede leer,
    // solo el admin SDK (función de billing) puede escribir.
    match /system/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
